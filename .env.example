ANTHROPIC_API_KEY=
SEC_IDENTITY="Your Name you@example.com"   # SEC requires this or you get 403s

# --- macro (row 5) ---
# fredaccount.stlouisfed.org/apikeys — free, issued immediately
FRED_API_KEY=

# --- market data: options chain, candles, macro (rows 5, 8, dispersion) ---
# londonstrategicedge.com/data — free key. Options chains with IV and greeks
# are the only free source for the dispersion input to lambda and V3 width.
LSE_API_KEY=
LSE_BASE_URL=

# --- news / search (rows 4, 5, 6) ---
# Date-filterable is the requirement, not a preference: without a published-date
# filter a news source returns today's internet for a historical as_of and
# cannot be backtested at all. Pick one.
EXA_API_KEY=
TAVILY_API_KEY=

# --- daily historic prices: avg_price for buybacks, peer prices ---
# Official API with explicit split/dividend adjustment control. yfinance is
# installed as a no-key fallback but adjusts prices by default, which would
# understate the price paid and inflate shares retired.
POLYGON_API_KEY=

# --- optional: one vendor for transcripts, consensus, news and peers ---
FMP_API_KEY=

FORECASTER_COST_CEILING_USD=25             # hard kill switch
FORECASTER_CACHE_DIR=data/cache
